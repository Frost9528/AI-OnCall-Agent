#     rules:
#       - alert: HighCPUUsage
#         expr: avg by (instance) (rate(node_cpu_seconds_total{mode!="idle"}[5m])) > 0.9
#         for: 5m
#         labels:
#           severity: critical
#         annotations:
#           summary: "实例 {{ $labels.instance }} CPU 使用率过高"
#           description: "CPU 使用率持续 5 分钟超过 90%（当前 {{ $value | humanizePercentage }}）"
